/* VERSIONINFO do cliente GUI JEDI VCS (v2026) - Jedivcs.exe e JvcsExternalDll.dll.
   Os numeros e textos de versao vem de tools\versao.ini (fonte unica), pelo
   cabecalho gerado ..\common\jvcsversao.rh. O jvcsver.res (fora do git) e
   gerado por tools\compilar.bat (tools\gerar-versao.ps1 + brcc32); para a IDE:
     powershell -File tools\gerar-versao.ps1 -Brcc <brcc32.exe> -Rc src\jedivcs\jvcsver.rc
   A versao enviada no LOGIN vem do PRODUCTVERSION numerico, FIXO em 2,5,0,0
   (GetJVCSAppProductVersionInt: Maj*100 + Min*10 + Release = 250), igual ao
   2.5.0.1030 (ProductVersion "2.5.0.0"). Nao mude. */

#include "..\common\jvcsversao.rh"
1 VERSIONINFO LOADONCALL MOVEABLE DISCARDABLE IMPURE
FILEVERSION JVCS_VER_FILEVERSION
PRODUCTVERSION JVCS_VER_PRODUCTVERSION
FILEFLAGSMASK 0x3F
FILEFLAGS JVCS_VER_FILEFLAGS
FILEOS VOS__WINDOWS32
FILETYPE VFT_APP
{
 BLOCK "StringFileInfo"
 {
  BLOCK "040904E4"
  {
   VALUE "CompanyName", "Project JEDI (www.delphi-jedi.org)\000"
   VALUE "FileDescription", "JEDI VCS GUI client\000"
   VALUE "FileVersion", JVCS_VER_FILEVERSION_STR
   VALUE "ProductVersion", JVCS_VER_PRODUCTVERSION_STR
   VALUE "InternalName", "Jedivcs.dpr/Jedivcsdll\000"
   VALUE "OriginalFilename", "Jedivcs.exe/Jedivcsdll.dll\000"
   VALUE "LegalCopyright", JVCS_VER_COPYRIGHT_STR
   VALUE "ProductName", JVCS_VER_PRODUCTNAME_STR
   VALUE "LegalTrademarks", "MPL 1.1\000"
   VALUE "BuildType", JVCS_VER_BUILDTYPE_STR
   VALUE "BuildTimestamp", JVCS_VER_BUILDTIMESTAMP_STR
   VALUE "InternalVersion", JVCS_VER_INTERNAL_STR
   VALUE "VCS", JVCS_VER_VCS_STR
  }
 }
 BLOCK "VarFileInfo"
 {
  VALUE "Translation", 0x0409,1252
 }
}