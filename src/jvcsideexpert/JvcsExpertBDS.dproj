<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <!-- JvcsExpertBDS.dproj - expert da IDE (wizard DLL, Win32), Delphi 11, 12 e 13.
         Gera JvcsExpertBDS22/23/37.dll ($LIBSUFFIX do .dpr) em bin\msbuild\<Dnn>\Win32\<cfg>.
         O build oficial e o tools\compilar-expert.bat (mesmas opcoes). Formato do
         Delphi 11; as IDEs novas atualizam ao salvar.
         PreBuildEvent: tools\gerar-toolsapi.ps1 gera a copia local da ToolsAPI sem
         DockForm (unit alias ToolsAPI=JvcsToolsAPI) - o expert nao pode importar o
         designide<nn>.bpl (ver tools\compilar-expert.bat). -->
    <PropertyGroup>
        <ProjectGuid>{52268872-B740-4609-9BE3-C53079525BF2}</ProjectGuid>
        <ProjectVersion>19.5</ProjectVersion>
        <FrameworkType>VCL</FrameworkType>
        <AppType>Library</AppType>
        <MainSource>JvcsExpertBDS.dpr</MainSource>
        <Base>True</Base>
        <Config Condition="'$(Config)'==''">Release</Config>
        <Platform Condition="'$(Platform)'==''">Win32</Platform>
        <TargetedPlatforms>1</TargetedPlatforms>
    </PropertyGroup>
    <Import Project="..\..\tools\msbuild\JediVCS2026.props" Condition="Exists('..\..\tools\msbuild\JediVCS2026.props')"/>
    <PropertyGroup Condition="'$(Config)'=='Base' or '$(Base)'!=''">
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="('$(Platform)'=='Win32' and '$(Base)'=='true') or '$(Base_Win32)'!=''">
        <Base_Win32>true</Base_Win32>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Debug' or '$(Cfg_1)'!=''">
        <Cfg_1>true</Cfg_1>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Release' or '$(Cfg_2)'!=''">
        <Cfg_2>true</Cfg_2>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base)'!=''">
        <SanitizedProjectName>JvcsExpertBDS</SanitizedProjectName>
        <GenDll>true</GenDll>
        <UsePackages>true</UsePackages>
        <DCC_UsePackage>rtl;vcl;designide</DCC_UsePackage>
        <DCC_Namespace>Winapi;System.Win;System;Vcl;Vcl.Imaging;Xml;$(DCC_Namespace)</DCC_Namespace>
        <DCC_UnitAlias>ToolsAPI=JvcsToolsAPI;FileHistoryAPI=JvcsFileHistoryAPI;$(DCC_UnitAlias)</DCC_UnitAlias>
        <JvcsExpertDcu>$(JvcsRoot)\dcu\msbuild\$(JvcsTag)\$(Platform)\$(Config)\JvcsExpertBDS</JvcsExpertDcu>
        <DCC_UnitSearchPath>$(JvcsExpertDcu)\toolsapi;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
        <DCC_ExeOutput>$(JvcsOutDir)</DCC_ExeOutput>
        <DCC_DcuOutput>$(JvcsExpertDcu)</DCC_DcuOutput>
        <BRCC_OutputDir>$(JvcsExpertDcu)\</BRCC_OutputDir>
        <DCC_CodePage>65001</DCC_CodePage>
        <DCC_MapFile>3</DCC_MapFile>
        <DCC_E>false</DCC_E>
        <DCC_N>false</DCC_N>
        <DCC_S>false</DCC_S>
        <DCC_F>false</DCC_F>
        <DCC_K>false</DCC_K>
        <VerInfo_IncludeVerInfo>false</VerInfo_IncludeVerInfo>
        <VerInfo_Locale>1046</VerInfo_Locale>
        <PreBuildEvent>powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(JvcsRoot)\tools\gerar-toolsapi.ps1&quot; -Bds &quot;$(BDS)&quot; -Out &quot;$(JvcsExpertDcu)\toolsapi&quot;</PreBuildEvent>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_1)'!=''">
        <DCC_Define>DEBUG;$(DCC_Define)</DCC_Define>
        <DCC_DebugDCUs>true</DCC_DebugDCUs>
        <DCC_Optimize>false</DCC_Optimize>
        <DCC_IntegerOverflowCheck>true</DCC_IntegerOverflowCheck>
        <DCC_RangeChecking>true</DCC_RangeChecking>
        <DCC_AssertionsAtRuntime>true</DCC_AssertionsAtRuntime>
        <DCC_DebugInformation>2</DCC_DebugInformation>
        <DCC_LocalDebugSymbols>true</DCC_LocalDebugSymbols>
        <DCC_SymbolReferenceInfo>2</DCC_SymbolReferenceInfo>
        <DCC_DebugInfoInExe>true</DCC_DebugInfoInExe>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_2)'!=''">
        <DCC_Define>RELEASE;$(DCC_Define)</DCC_Define>
        <DCC_Optimize>true</DCC_Optimize>
        <DCC_IntegerOverflowCheck>false</DCC_IntegerOverflowCheck>
        <DCC_RangeChecking>false</DCC_RangeChecking>
        <DCC_AssertionsAtRuntime>false</DCC_AssertionsAtRuntime>
        <DCC_DebugInformation>0</DCC_DebugInformation>
        <DCC_LocalDebugSymbols>false</DCC_LocalDebugSymbols>
        <DCC_SymbolReferenceInfo>0</DCC_SymbolReferenceInfo>
    </PropertyGroup>
    <ItemGroup>
        <DelphiCompile Include="$(MainSource)">
            <MainSource>MainSource</MainSource>
        </DelphiCompile>
        <RcCompile Include="JvcsExpertBDS_ver.rc">
            <Form>JvcsExpertBDS_ver.res</Form>
        </RcCompile>
        <BuildConfiguration Include="Base">
            <Key>Base</Key>
        </BuildConfiguration>
        <BuildConfiguration Include="Debug">
            <Key>Cfg_1</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
        <BuildConfiguration Include="Release">
            <Key>Cfg_2</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Delphi.Personality.12</Borland.Personality>
        <Borland.ProjectType>Library</Borland.ProjectType>
        <BorlandProject>
            <Delphi.Personality>
                <Source>
                    <Source Name="MainSource">JvcsExpertBDS.dpr</Source>
                </Source>
            </Delphi.Personality>
            <Platforms>
                <Platform value="Win32">True</Platform>
            </Platforms>
        </BorlandProject>
        <ProjectFileVersion>12</ProjectFileVersion>
    </ProjectExtensions>
    <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Delphi.Targets')"/>
    <Import Project="$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj" Condition="Exists('$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj')"/>
</Project>
